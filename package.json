{
  "name": "selog-logis-serviceorder",
  "version": "1.0.0",
  "description": "SELOG LOGIS Service Order",
  "main": "dist/server.js",
  "scripts": {
    "clean": "rimraf dist public",
    "tsc": "tsc -p ./tsconfig.json",
    "build": "npm-run-all clean tsc && tsc-alias",
    "serve": "node -r ./tsconfig-paths-bootstrap.js dist/app.js",
    "start": "npm-run-all serve",
    "start:dev": "export NODE_OPTIONS=set IS_NON_CLUSTER=1 && nodemon -r tsconfig-paths/register src/app.ts",
    "lint": "tslint '*.ts'",
    "test": "mocha --timeout=10000 -r tsconfig-paths/register -r node_modules/ts-node/register \"src/tests/**/*.test.ts\" -exit",
    "test:coverage": "nyc mocha --timeout=10000 -r tsconfig-paths/register -r node_modules/ts-node/register \"src/tests/**/*.test.ts\" -exit",
    "gen:swag": "ts-node -r tsconfig-paths/register src/utils/swagger.util.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerserasiautoraya/SELOG_LOGIS_ServiceOrder.git"
  },
  "author": "SERA",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.943.0",
    "@aws-sdk/client-sqs": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "3.989.0",
    "@azure/event-hubs": "^6.0.0",
    "@azure/service-bus": "^7.9.5",
    "@azure/storage-blob": "^12.33.0",
    "@sentry/node": "^8.55.0",
    "argon2": "^0.44.0",
    "async-retry": "^1.3.3",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "canvas": "^3.1.0",
    "class-sanitizer": "^1.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^7.2.0",
    "inversify": "^6.2.2",
    "inversify-express-utils": "^6.4.10",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "long": "^5.3.2",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.47",
    "mongoose": "^9.1.5",
    "morgan": "^1.10.0",
    "mssql": "^11.0.1",
    "multer": "^2.0.2",
    "node-vault": "^0.10.2",
    "npm-run-all": "^4.1.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.7",
    "sharp": "^0.33.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/async-retry": "^1.4.9",
    "@types/bcrypt": "^5.0.2",
    "@types/body-parser": "^1.19.5",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/long": "^4.0.2",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.13.1",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.20.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "nyc": {
    "extension": [
      ".ts",
      ".tsx"
    ],
    "exclude": [
      "**/*.d.ts",
      "dist/**",
      "test/**",
      "coverage/",
      "src/server.ts",
      "src/app.ts",
      "src/constants/**"
    ],
    "reporter": [
      "html",
      "text"
    ],
    "all": true
  },
  "bugs": {
    "url": "https://github.com/developerserasiautoraya/SELOG_LOGIS_ServiceOrder/issues"
  },
  "homepage": "https://github.com/developerserasiautoraya/SELOG_LOGIS_ServiceOrder#readme",
  "nodemonConfig": {
    "ignore": [
      "notes/*"
    ]
  }
}
